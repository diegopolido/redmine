# Production secrets for Redmine (Kamal). Copy to .env (git- and docker-ignored)
# or run bin/migration/init_secrets.sh, which creates .env with random passwords.
# Read by .kamal/secrets through bin/env-secret (an exported environment
# variable with the same name takes precedence).

# GitHub token with write:packages (ghcr.io/diegopolido/redmine)
KAMAL_REGISTRY_PASSWORD=

# Fixed across deploys — changing it logs everybody out. openssl rand -hex 64
SECRET_KEY_BASE=

# MySQL accessory `db` (only applied on the first boot of the mysql_data volume)
MYSQL_ROOT_PASSWORD=
REDMINE_DB_PASSWORD=

# Brevo SMTP (Brevo > SMTP & API > SMTP tab): login and SMTP key (xsmtpsib-...)
SMTP_USERNAME=
SMTP_PASSWORD=
