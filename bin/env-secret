#!/usr/bin/env bash
# Prints the value of a deploy secret, for use in .kamal/secrets:
#   SECRET_KEY_BASE=$(bin/env-secret SECRET_KEY_BASE)
#
# Lookup order: environment variable, then the local .env file (git-ignored).
# Missing or empty values are reported on stderr and exit 1, unless the
# name is passed with --optional.
set -euo pipefail

optional=0
if [ "${1:-}" = "--optional" ]; then optional=1; shift; fi
name=${1:?usage: bin/env-secret [--optional] NAME}
env_file="$(cd "$(dirname "$0")/.." && pwd)/.env"

value=${!name:-}
if [ -z "$value" ] && [ -f "$env_file" ]; then
  # Last `NAME=value` line wins; strips optional `export ` and surrounding quotes.
  line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?${name}=" "$env_file" | tail -1 || true)
  value=${line#*=}
  value=${value%$'\r'}
  if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then value=${BASH_REMATCH[1]}; fi
fi

if [ -z "$value" ] && [ "$optional" -eq 0 ]; then
  echo "bin/env-secret: $name is not set (environment or $env_file)" >&2
  exit 1
fi
printf '%s' "$value"
