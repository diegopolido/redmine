# Production secrets for Redmine (Kamal). Copy to .env.production (git- and docker-ignored)
# or run bin/migration/init_secrets.sh, which creates .env.production with random passwords.
# Read by .kamal/secrets through bin/env-secret (an exported environment
# variable with the same name takes precedence).

# GitHub token with write:packages (ghcr.io/diegopolido/redmine)
KAMAL_REGISTRY_PASSWORD=

# Fixed across deploys — changing it logs everybody out. openssl rand -hex 64
SECRET_KEY_BASE=

# PostgreSQL accessory `db`, user `redmine` (applied on the first boot of the
# redmine_pgdata volume; to change it later use ALTER USER, see DEPLOY.md)
REDMINE_DB_PASSWORD=

# SMTP via Brevo (same variables as the other apps). Login and SMTP key
# (xsmtpsib-..., not the xkeysib- API key): Brevo > SMTP & API > SMTP tab.
# Leave SMTP_ADDRESS empty to disable e-mail delivery.
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender (must be a verified sender in Brevo); overrides Redmine's
# "Emission email address" setting at every boot.
MAILER_FROM='Redmine <redmine@polidosantana.com.br>'
