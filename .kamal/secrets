# Kamal secrets — versioned on purpose: this file contains NO values, only
# where to read them from. bin/env-secret looks up the environment first,
# then the local .env.production file (git- and docker-ignored; template: .env.production.example).
#
# NEVER put literal secret values in this file.

KAMAL_REGISTRY_PASSWORD=$(bin/env-secret KAMAL_REGISTRY_PASSWORD)

SECRET_KEY_BASE=$(bin/env-secret SECRET_KEY_BASE)

REDMINE_DB_PASSWORD=$(bin/env-secret REDMINE_DB_PASSWORD)
# The postgres image uses POSTGRES_PASSWORD (first boot only) to create the
# `redmine` user, so it must equal REDMINE_DB_PASSWORD.
POSTGRES_PASSWORD=$(bin/env-secret REDMINE_DB_PASSWORD)

# SMTP (Brevo) — optional here; .kamal/hooks/pre-connect requires the
# credentials whenever SMTP_ADDRESS is set.
SMTP_ADDRESS=$(bin/env-secret --optional SMTP_ADDRESS)
SMTP_PORT=$(bin/env-secret --optional SMTP_PORT)
SMTP_USERNAME=$(bin/env-secret --optional SMTP_USERNAME)
SMTP_PASSWORD=$(bin/env-secret --optional SMTP_PASSWORD)
# Sender, applied to Redmine's Setting.mail_from at every boot.
MAILER_FROM=$(bin/env-secret --optional MAILER_FROM)
