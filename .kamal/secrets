# Kamal secrets — versioned on purpose: this file contains NO values, only
# where to read them from. bin/env-secret looks up the environment first,
# then the local .env file (git- and docker-ignored; template: .env.example).
#
# NEVER put literal secret values in this file.

KAMAL_REGISTRY_PASSWORD=$(bin/env-secret KAMAL_REGISTRY_PASSWORD)

SECRET_KEY_BASE=$(bin/env-secret SECRET_KEY_BASE)

MYSQL_ROOT_PASSWORD=$(bin/env-secret MYSQL_ROOT_PASSWORD)
REDMINE_DB_PASSWORD=$(bin/env-secret REDMINE_DB_PASSWORD)
# The mysql image uses MYSQL_PASSWORD (first boot only) to create the
# `redmine` user, so it must equal REDMINE_DB_PASSWORD.
MYSQL_PASSWORD=$(bin/env-secret REDMINE_DB_PASSWORD)

SMTP_USERNAME=$(bin/env-secret SMTP_USERNAME)
SMTP_PASSWORD=$(bin/env-secret SMTP_PASSWORD)
