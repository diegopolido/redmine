# Copy to .kamal/secrets (git-ignored) — or run bin/migration/init_secrets.sh,
# which creates it with random passwords. NEVER commit .kamal/secrets.
#
# Kamal reads this file as dotenv: `$VAR` is taken from your shell
# environment, `$(cmd)` runs a command (e.g. a password manager CLI).
# You may also paste literal values directly in .kamal/secrets.

# GitHub token with write:packages (push/pull ghcr.io/diegopolido/redmine)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails secret_key_base — generate once (bin/rails secret / openssl rand -hex 64)
# and keep it FIXED across deploys, otherwise all sessions/tokens break.
SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE

# MySQL accessory `db`
MYSQL_ROOT_PASSWORD=$REDMINE_MYSQL_ROOT_PASSWORD
REDMINE_DB_PASSWORD=$REDMINE_DB_PASSWORD
# Used by the mysql image only on first boot to create the `redmine` user.
MYSQL_PASSWORD=$REDMINE_DB_PASSWORD

# SMTP password (leave empty if SMTP is not configured)
SMTP_PASSWORD=$REDMINE_SMTP_PASSWORD
